# PostgreSQL connection string
DATABASE_URL=postgresql://user:password@localhost:5432/mtym

# Port the Express server listens on
PORT=3001

# Authentik OIDC — issuer URL must end with a trailing slash
# Typically: https://<authentik-host>/application/o/<app-slug>/
AUTHENTIK_ISSUER=https://your-authentik.example.com/application/o/mtym/

# Client ID configured in Authentik (used as the expected `aud` claim)
AUTHENTIK_AUDIENCE=mtym-backend

# Directory for uploaded files (created automatically on startup)
UPLOADS_DIR=./uploads

# Frontend origin for CORS
CORS_ORIGIN=http://localhost:5173

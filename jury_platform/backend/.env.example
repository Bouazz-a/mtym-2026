# PostgreSQL connection string (matches jury_platform/docker-compose.yml)
DATABASE_URL=postgresql://mtym_jury:change-me@localhost:5434/mtym_jury

# Secret used to sign login tokens — generate with: openssl rand -hex 32
JWT_SECRET=

# Port the Express server listens on
PORT=3001

# Main site's report bucket (MinIO). Use a READ-ONLY key limited to
# mtym-s3/reports/*. Leave S3_BUCKET empty to run without it (report links
# then answer 503). Path-style URLs are the default with a custom endpoint;
# set S3_FORCE_PATH_STYLE=false for virtual-host style.
S3_BUCKET=mtym-s3
S3_REGION=us-east-1
S3_ENDPOINT=https://s3.mathmaroc.org
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=

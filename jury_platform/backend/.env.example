# PostgreSQL connection string (matches jury_platform/docker-compose.yml)
DATABASE_URL=postgresql://mtym_jury:change-me@localhost:5434/mtym_jury

# Secret used to sign login tokens — generate with: openssl rand -hex 32
JWT_SECRET=

# Port the Express server listens on
PORT=3001

# Main site's private report bucket — use a READ-ONLY key. Leave S3_BUCKET
# empty to run without it (report links then answer 503).
S3_BUCKET=
S3_REGION=
# Only for non-AWS providers (Cloudflare R2, DigitalOcean Spaces, MinIO…)
S3_ENDPOINT=
S3_FORCE_PATH_STYLE=false
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=

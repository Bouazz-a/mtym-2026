# Read by docker compose (jury_platform/.env). Must match backend/.env's DATABASE_URL.
POSTGRES_DB=mtym_jury
POSTGRES_USER=mtym_jury
POSTGRES_PASSWORD=change-me

# Server only: where the daily backups and the pre-deploy dumps go (the
# main site's are in /root/backups). Defaults to jury_platform/backups.
# BACKUP_DIR=/root/backups/mtym-jury

# Host port of the database (loopback only). 5434 by default.
# DB_PORT=5434
